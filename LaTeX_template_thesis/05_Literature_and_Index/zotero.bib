@article{baggettaTwoporeDomainPotassium2025,
	title = {Two-pore domain potassium channels (K$_{\textrm{2P}}$) in {GtoPdb} v.2025.4},
	volume = {2025},
	rights = {http://creativecommons.org/licenses/by-sa/4.0},
	issn = {2633-1020},
	url = {https://journals.ed.ac.uk/gtopdb-cite/article/view/11988},
	doi = {10.2218/gtopdb/F79/2025.4},
	abstract = {The 4TM family of K channels mediate many of the background potassium currents observed in native cells. They are open across the physiological voltage-range and are regulated by a wide array of neurotransmitters and biochemical mediators. The pore-forming α-subunit contains two pore loop (P) domains and two subunits assemble to form one ion conduction pathway lined by four P domains. It is important to note that single channels do not have two pores but that each subunit has two P domains in its primary sequence; hence the name two-pore domain, or K2P channels (and not two-pore channels). Some of the K2P subunits can form heterodimers across subfamilies (e.g. K2P3.1 with K2P9.1). The nomenclature of 4TM K channels in the literature is still a mixture of {IUPHAR} and common names. The suggested division into subfamilies, described in the more detailed introduction, is based on similarities in both structural and functional properties within subfamilies and this explains the "common abbreviation" nomenclature in the tables below.},
	number = {4},
	journaltitle = {{IUPHAR}/{BPS} Guide to Pharmacology {CITE}},
	shortjournal = {{GtoPdb} {CITE}},
	author = {Baggetta, Austin M. and Bayliss, Douglas A. and Czirják, Gábor and Enyedi, Péter and Goldstein, Steve A.N. and Lesage, Florian and Minor, Jr., Daniel L. and Plant, Leigh D. and Sepúlveda, Francisco},
	urldate = {2026-03-14},
	date = {2025-12-10},
