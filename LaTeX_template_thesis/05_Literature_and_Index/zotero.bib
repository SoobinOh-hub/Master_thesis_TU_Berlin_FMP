@article{fellerConstantPressureMolecular1995,
	title = {Constant pressure molecular dynamics simulation: The Langevin piston method},
	volume = {103},
	issn = {0021-9606},
	url = {https://doi.org/10.1063/1.470648},
	doi = {10.1063/1.470648},
	shorttitle = {Constant pressure molecular dynamics simulation},
	abstract = {A new method for performing molecular dynamics simulations under constant pressure is presented. In the method, which is based on the extended system formalism introduced by Andersen, the deterministic equations of motion for the piston degree of freedom are replaced by a Langevin equation; a suitable choice of collision frequency then eliminates the unphysical ‘‘ringing’’ of the volume associated with the piston mass. In this way it is similar to the ‘‘weak coupling algorithm’’ developed by Berendsen and co‐workers to perform molecular dynamics simulation without piston mass effects. It is shown, however, that the weak coupling algorithm induces artifacts into the simulation which can be quite severe for inhomogeneous systems such as aqueous biopolymers or liquid/liquid interfaces.},
	pages = {4613--4621},
	number = {11},
	journaltitle = {The Journal of Chemical Physics},
	shortjournal = {J. Chem. Phys.},
	author = {Feller, Scott E. and Zhang, Yuhong and Pastor, Richard W. and Brooks, Bernard R.},
	urldate = {2026-03-15},
	date = {1995-09-15},
}

@article{adamRevisedCHARMMForce2018,
	title = {Revised {CHARMM} force field parameters for iron-containing cofactors of photosystem {II}},
	volume = {39},
	rights = {© 2017 Wiley Periodicals, Inc.},
	issn = {1096-987X},
	url = {https://onlinelibrary.wiley.com/doi/abs/10.1002/jcc.24918},
	doi = {10.1002/jcc.24918},
	abstract = {Photosystem {II} is a complex protein–cofactor machinery that splits water molecules into molecular oxygen, protons, and electrons. All-atom molecular dynamics simulations have the potential to contribute to our general understanding of how photosystem {II} works. To perform reliable all-atom simulations, we need accurate force field parameters for the cofactor molecules. We present here {CHARMM} bonded and non-bonded parameters for the iron-containing cofactors of photosystem {II} that include a six-coordinated heme moiety coordinated by two histidine groups, and a non-heme iron complex coordinated by bicarbonate and four histidines. The force field parameters presented here give water interaction energies and geometries in good agreement with the quantum mechanical target data. © 2017 Wiley Periodicals, Inc.},
	pages = {7--20},
	number = {1},
	journaltitle = {Journal of Computational Chemistry},
	author = {Adam, Suliman and Knapp-Mohammady, Michaela and Yi, Jun and Bondar, Ana-Nicoleta},
	urldate = {2026-03-15},
	date = {2018},
	langid = {english},
	note = {\_eprint: https://onlinelibrary.wiley.com/doi/pdf/10.1002/jcc.24918},
	keywords = {{CHARMM} force field, heme, non-heme iron, parametrization, photosystem {II}},
}

