@article{proksNorfluoxetineInhibitsTREK22021,
	title = {Norfluoxetine inhibits {TREK}-2 K2P channels by multiple mechanisms including state-independent effects on the selectivity filter gate},
	volume = {153},
	issn = {0022-1295},
	url = {https://pmc.ncbi.nlm.nih.gov/articles/PMC8155809/},
	doi = {10.1085/jgp.202012812},
	abstract = {Proks et al. show that the antidepressant norfluoxetine affects the behavior of {TREK}-2 two-pore domain K+ channels by regulating the equilibrium between their open and closed states as well as their filter gating., The {TREK} subfamily of two-pore domain K+ (K2P) channels are inhibited by fluoxetine and its metabolite, norfluoxetine ({NFx}). Although not the principal targets of this antidepressant, {TREK} channel inhibition by {NFx} has provided important insights into the conformational changes associated with channel gating and highlighted the role of the selectivity filter in this process. However, despite the availability of {TREK}-2 crystal structures with {NFx} bound, the precise mechanisms underlying {NFx} inhibition remain elusive. {NFx} has previously been proposed to be a state-dependent inhibitor, but its binding site suggests many possible ways in which this positively charged drug might inhibit channel activity. Here we show that {NFx} exerts multiple effects on single-channel behavior that influence both the open and closed states of the channel and that the channel can become highly activated by 2-{APB} while remaining in the down conformation. We also show that the inhibitory effects of {NFx} are unrelated to its positive charge but can be influenced by agonists which alter filter stability, such as {ML}335, as well as by an intrinsic voltage-dependent gating process within the filter. {NFx} therefore not only inhibits channel activity by altering the equilibrium between up and down conformations but also can directly influence filter gating. These results provide further insight into the complex allosteric mechanisms that modulate filter gating in {TREK} K2P channels and highlight the different ways in which filter gating can be regulated to permit polymodal regulation.},
	pages = {e202012812},
	number = {8},
	journaltitle = {The Journal of General Physiology},
	shortjournal = {J Gen Physiol},
	author = {Proks, Peter and Schewe, Marcus and Conrad, Linus J. and Rao, Shanlin and Rathje, Kristin and Rödström, Karin E.J. and Carpenter, Elisabeth P. and Baukrowitz, Thomas and Tucker, Stephen J.},
	urldate = {2026-08-07},
	date = {2021-05-25},
}

@article{Rödström2025,
	title = {Cryo-{EM} structure of the human {THIK}-1 K2P K+ channel reveals a lower Y gate regulated by lipids and anesthetics},
	volume = {32},
	rights = {2025 The Author(s)},
	issn = {1545-9985},
	url = {https://www.nature.com/articles/s41594-025-01497-6},
	doi = {10.1038/s41594-025-01497-6},
	abstract = {{THIK}-1 ({KCNK}13) is a halothane-inhibited and anionic-lipid-activated two-pore domain (K2P) K+ channel implicated in microglial activation and neuroinflammation, and a current target for the treatment of neurodegenerative disorders, for example Alzheimer’s disease and amyothropic lateral sclerosis ({ALS}). However, compared to other K2P channels, little is known about the structural and functional properties of {THIK}-1. Here we present a 3.16-Å-resolution cryo-{EM} structure of human {THIK}-1 that reveals several distinct features, in particular, a tyrosine in M4 that contributes to a lower ‘Y gate’ that opens upon activation by physiologically relevant G-protein-coupled receptor and lipid signaling pathways. We demonstrate that linoleic acid bound within a modulatory pocket adjacent to the filter influences channel activity, and that halothane inhibition involves a binding site within the inner cavity, both resulting in conformational changes to the Y gate. Finally, the extracellular cap domain contains positively charged residues that line the ion exit pathway and contribute to the distinct biophysical properties of this channel. Overall, our results provide structural insights into {THIK}-1 function and identify distinct regulatory sites that expand its potential as a drug target for the modulation of microglial function.},
	pages = {1167--1174},
	number = {7},
	journaltitle = {Nature Structural \& Molecular Biology},
	shortjournal = {Nat Struct Mol Biol},
	publisher = {Nature Publishing Group},
	author = {Rödström, Karin E. J. and Eymsh, Bisher and Proks, Peter and Hayre, Mehtab S. and Cordeiro, Sönke and Mendez-Otalvaro, Edward and Madry, Christian and Rowland, Anna and Kopec, Wojciech and Newstead, Simon and Baukrowitz, Thomas and Schewe, Marcus and Tucker, Stephen J.},
	urldate = {2026-07-22},
	date = {2025-07},
	langid = {english},
	keywords = {Cryoelectron microscopy, Ion transport},
}

