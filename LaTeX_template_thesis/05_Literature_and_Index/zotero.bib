	title = {Novel insights into K+ selectivity from high-resolution structures of an open K+ channel pore},
	volume = {17},
	rights = {2010 Springer Nature America, Inc.},
	issn = {1545-9985},
	url = {https://www.nature.com/articles/nsmb.1865},
