@article{finkNeuronalTwoDomain1998,
  title = {A Neuronal Two {{P}} Domain {{K}}+ Channel Stimulated by Arachidonic Acid and Polyunsaturated Fatty Acids},
  author = {Fink, M. and Lesage, F. and Duprat, F. and Heurteaux, C. and Reyes, R. and Fosset, M. and Lazdunski, M.},
  date = {1998-06-15},
  journaltitle = {The EMBO journal},
