@article{proksNorfluoxetineInhibitsTREK22021,
  title = {Norfluoxetine Inhibits {{TREK-2 K2P}} Channels by Multiple Mechanisms Including State-Independent Effects on the Selectivity Filter Gate},
  author = {Proks, Peter and Schewe, Marcus and Conrad, Linus J. and Rao, Shanlin and Rathje, Kristin and R\"odstr\"om, Karin E.J. and Carpenter, Elisabeth P. and Baukrowitz, Thomas and Tucker, Stephen J.},
