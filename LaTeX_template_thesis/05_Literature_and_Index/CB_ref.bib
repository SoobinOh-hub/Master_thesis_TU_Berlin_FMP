@article{peiOncogenicPotentialTASK32003,
  title = {Oncogenic Potential of {{TASK3}} ({{Kcnk9}}) Depends on {{K}}+ Channel Function},
  author = {Pei, Lin and Wiser, Ofer and Slavin, Anthony and Mu, David and Powers, Scott and Jan, Lily Yeh and Hoey, Timothy},
  date = {2003-06-24},
