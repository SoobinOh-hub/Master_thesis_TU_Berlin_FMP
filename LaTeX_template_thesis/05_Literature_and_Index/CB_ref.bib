@article{mcclenaghanPolymodalActivationTREK22016,
  title = {Polymodal Activation of the {{TREK-2 K2P}} Channel Produces Structurally Distinct Open States},
  author = {McClenaghan, Conor and Schewe, Marcus and Aryal, Prafulla and Carpenter, Elisabeth P. and Baukrowitz, Thomas and Tucker, Stephen J.},
  date = {2016-05-30},
  journaltitle = {Journal of General Physiology},
  shortjournal = {J Gen Physiol},
  volume = {147},
  number = {6},
  pages = {497--505},
  issn = {0022-1295},
  doi = {10.1085/jgp.201611601},
  abstract = {The TREK subfamily of two-pore domain (K2P) K+ channels exhibit polymodal gating by a wide range of physical and chemical stimuli. Crystal structures now exist for these channels in two main states referred to as the ``up'' and ``down'' conformations. However, recent studies have resulted in contradictory and mutually exclusive conclusions about the functional (i.e., conductive) status of these two conformations. To address this problem, we have used the state-dependent TREK-2 inhibitor norfluoxetine that can only bind to the down state, thereby allowing us to distinguish between these two conformations when activated by different stimuli. Our results reconcile these previously contradictory gating models by demonstrating that activation by pressure, temperature, voltage, and pH produce more than one structurally distinct open state and reveal that channel activation does not simply involve switching between the up and down conformations. These results also highlight the diversity of structural mechanisms that K2P channels use to integrate polymodal gating signals.},
  file = {/home/soobin/Zotero/storage/M3CXFENJ/McClenaghan et al. - 2016 - Polymodal activation of the TREK-2 K2P channel produces structurally distinct open states.pdf;/home/soobin/Zotero/storage/NPSRPTCE/jgp.html}
}
